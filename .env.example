# Google Gemini API key — Vision解析に使う（無料枠あり）。
# https://aistudio.google.com/apikey から取得する。
GEMINI_API_KEY=AIzaSy...

# Cloudflare D1（フィードバック保存）
# Account ID: Cloudflareダッシュボード右サイドバー
CLOUDFLARE_ACCOUNT_ID=
# D1 Database ID: D1管理画面 → eaa-scorer-feedback
CLOUDFLARE_D1_DATABASE_ID=
# API Token: My Profile → API Tokens → Create Token
# Permission: Account → D1 → Edit
CLOUDFLARE_API_TOKEN=

# 管理者用フィードバック取得トークン（任意の文字列、GETエンドポイント保護）
FEEDBACK_ADMIN_TOKEN=

# /admin ページの Basic 認証（"username:password" 形式）
# 例: admin:$(openssl rand -hex 16)
ADMIN_BASIC_AUTH=admin:strong-random-password

# v0.4.2+: API レート制限のための IP ハッシュ secret（任意、未設定時は固定 fallback）。
# 同値を Vercel env vars にも設定すること。生成例:
#   openssl rand -hex 32
IP_HASH_SECRET=

# v0.4.5+: /api/coach のレート制限（req/h/IP、デフォルト 10）。
COACH_RATE_LIMIT=10

# v0.4.5+: /api/analyze のレート制限（req/h/IP、デフォルト 10）。
# 1 リクエスト最大 9 並列 Vision 呼び出しなので Vision 呼び出し上限は 90/h/IP。
ANALYZE_RATE_LIMIT=10

# v0.4.6+: GET /api/feedback (admin endpoint) のレート制限（req/h/IP、デフォルト 30）。
# 401 (token 不一致) 含めて全リクエストを request_log に記録するので、
# brute-force 試行を可視化できる。
FEEDBACK_ADMIN_RATE_LIMIT=30
